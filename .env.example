NEXT_PUBLIC_APP_URL=https://deals.seudominio.com
NEXT_PUBLIC_DEAL_ALERT_DOMAIN=deals.seudominio.com

# WhatsApp alerts: choose Evolution API or Twilio in your n8n workflow.
WHATSAPP_API_URL=http://maestro-evolution:8080/message/sendText
EVOLUTION_API_URL=http://maestro-evolution:8080
EVOLUTION_API_KEY=replace_me
CAR_DEAL_ALERT_WHATSAPP_TO=15555550123

# Email alerts: Resend is recommended for fast domain verification.
RESEND_API_KEY=replace_me
CAR_DEAL_ALERT_EMAIL_TO=ops@example.com
CAR_DEAL_ALERT_EMAIL_FROM=alerts@seudominio.com
CAR_DEAL_ALERTS_API_URL=https://deals.seudominio.com/api/car-deal-alerts

# Deal scoring thresholds.
DEAL_ALERT_MIN_SCORE=82
DEAL_ALERT_MIN_DISCOUNT_PERCENT=20
DEAL_ALERT_TARGET_MODELS=Toyota RAV4 Hybrid,Toyota Camry Hybrid,Toyota Corolla Hybrid,Toyota Highlander Hybrid
