{
  "name": "0869_monitoring_health_by_response_03",
  "nodes": [
    {
      "name": "Cron_by_response",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        250,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 */5 * * * *"
            }
          ]
        }
      },
      "id": "3a083ede-281a-7f8f-6ceb-50787a41515c"
    },
    {
      "name": "Set_by_response_Context",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [
        500,
        300
      ],
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "0",
              "name": "category",
              "value": "monitoring_health",
              "type": "string"
            },
            {
              "id": "1",
              "name": "variation",
              "value": "by_response",
              "type": "string"
            },
            {
              "id": "2",
              "name": "workflow_id",
              "value": "869",
              "type": "string"
            }
          ]
        }
      },
      "id": "4a4bb6cf-2ebf-4cbd-60d3-f7436c222ab1"
    },
    {
      "name": "Health_Check",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        750,
        300
      ],
      "parameters": {
        "url": "http://crewai-api:8001/health",
        "method": "GET",
        "options": {}
      },
      "id": "75184c91-62ed-ccf5-767e-325d9ddea94c"
    },
    {
      "name": "Is_Healthy",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1000,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": ""
          },
          "conditions": [
            {
              "leftValue": "={{$json[\"status\"]}}",
              "rightValue": "healthy",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "00b959aa-3c3f-a5f0-7800-11f51bf2bd2e"
    },
    {
      "name": "Email_Report",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [
        1500,
        300
      ],
      "parameters": {
        "fromEmail": "={{ $env.EMAIL_FROM }}",
        "toEmail": "={{ $json.email }}",
        "subject": "[monitoring_health] Report - by_response",
        "html": "<h2>monitoring_health Report</h2><p>Variation: by_response</p><p>Result: {{$json.result}}</p>",
        "options": {}
      },
      "id": "eff6044d-68af-b58e-7ad1-599a4ba27e9f"
    }
  ],
  "connections": {
    "Cron_by_response": {
      "main": [
        [
          {
            "node": "Set_by_response_Context",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set_by_response_Context": {
      "main": [
        [
          {
            "node": "Health_Check",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Health_Check": {
      "main": [
        [
          {
            "node": "Is_Healthy",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is_Healthy": {
      "main": [
        [
          {
            "node": "Email_Report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner"
  },
  "tags": [
    {
      "name": "monitoring"
    },
    {
      "name": "health"
    }
  ]
}