{
  "name": "0960_infrastructure_ops_by_priority_01",
  "nodes": [
    {
      "name": "Schedule_by_priority",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        250,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 */5 * * * *"
            }
          ]
        }
      },
      "id": "0dd9f002-f451-5400-3046-9fd70c1e8315"
    },
    {
      "name": "Set_by_priority_Context",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [
        500,
        300
      ],
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "0",
              "name": "category",
              "value": "infrastructure_ops",
              "type": "string"
            },
            {
              "id": "1",
              "name": "variation",
              "value": "by_priority",
              "type": "string"
            },
            {
              "id": "2",
              "name": "workflow_id",
              "value": "960",
              "type": "string"
            }
          ]
        }
      },
      "id": "5fc2fbeb-6e12-e63d-3f6d-6e33e4506b16"
    },
    {
      "name": "Health_Check",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        750,
        300
      ],
      "parameters": {
        "url": "http://crewai-api:8001/health",
        "method": "GET",
        "options": {}
      },
      "id": "8f301c65-2859-3fe9-bb2b-1bb3df5d9d2e"
    },
    {
      "name": "Is_Healthy",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1000,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": ""
          },
          "conditions": [
            {
              "leftValue": "={{$json[\"status\"]}}",
              "rightValue": "healthy",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "74180f80-1c9e-8c9f-7d21-97e44d741452"
    },
    {
      "name": "Notify_Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [
        1000,
        300
      ],
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "[INFRASTRUCTURE_OPS] Workflow 0960 (by_priority) completed.\nResult: {{ $json.result }}",
        "additionalFields": {}
      },
      "credentials": {
        "telegramApi": {
          "id": "1",
          "name": "Telegram"
        }
      },
      "id": "659bcea9-59a6-5ffb-11dc-ed6c55eb4e86"
    }
  ],
  "connections": {
    "Schedule_by_priority": {
      "main": [
        [
          {
            "node": "Set_by_priority_Context",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set_by_priority_Context": {
      "main": [
        [
          {
