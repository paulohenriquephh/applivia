            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Health_Check": {
      "main": [
        [
          {
            "node": "Is_Healthy",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is_Healthy": {
      "main": [
        [
          {
            "node": "Notify_Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
