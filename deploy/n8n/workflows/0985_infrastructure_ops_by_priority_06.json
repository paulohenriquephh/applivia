{
  "name": "0985_infrastructure_ops_by_priority_06",
  "nodes": [
    {
      "name": "Schedule_by_priority",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        250,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 */15 * * * *"
            }
          ]
        }
      },
      "id": "b0c5cfc9-352f-78ce-5db1-d25e260cb212"
    },
    {
      "name": "Set_by_priority_Context",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [
        500,
        300
      ],
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "0",
              "name": "category",
              "value": "infrastructure_ops",
              "type": "string"
            },
            {
              "id": "1",
              "name": "variation",
              "value": "by_priority",
              "type": "string"
            },
            {
              "id": "2",
              "name": "workflow_id",
              "value": "985",
              "type": "string"
            }
          ]
        }
      },
      "id": "2f90c214-4dc9-2905-2bee-e888f00af1be"
    },
    {
      "name": "Health_Check",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        750,
        300
      ],
      "parameters": {
        "url": "http://crewai-api:8001/health",
        "method": "GET",
        "options": {}
      },
      "id": "66a2ac30-1d75-5b97-ddbb-54643a2d1d04"
    },
    {
      "name": "Is_Healthy",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1000,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": ""
          },
          "conditions": [
            {
              "leftValue": "={{$json[\"status\"]}}",
              "rightValue": "healthy",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "37e21eed-603c-1a82-8f2f-9e030aa03886"
    },
    {
      "name": "Email_Report",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [
        1250,
        300
      ],
      "parameters": {
        "fromEmail": "={{ $env.EMAIL_FROM }}",
        "toEmail": "={{ $json.email }}",
        "subject": "[infrastructure_ops] Report - by_priority",
        "html": "<h2>infrastructure_ops Report</h2><p>Variation: by_priority</p><p>Result: {{$json.result}}</p>",
        "options": {}
      },
      "id": "9813ffe9-20de-b24c-0d93-fdc6ce146e30"
    }
  ],
  "connections": {
    "Schedule_by_priority": {
      "main": [
