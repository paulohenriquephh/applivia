{
  "name": "1000_infrastructure_ops_by_priority_09",
  "nodes": [
    {
      "name": "Schedule_by_priority",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        250,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 */5 * * * *"
            }
          ]
        }
      },
      "id": "05991a3a-0e36-1ae7-ecc2-fafba36d463c"
    },
    {
      "name": "Set_by_priority_Context",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [
        500,
        300
      ],
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "0",
              "name": "category",
              "value": "infrastructure_ops",
              "type": "string"
            },
            {
              "id": "1",
              "name": "variation",
              "value": "by_priority",
              "type": "string"
            },
            {
              "id": "2",
              "name": "workflow_id",
              "value": "1000",
              "type": "string"
            }
          ]
        }
      },
      "id": "83a204ea-9f4f-677d-2914-7dadc56dec50"
    },
    {
      "name": "Health_Check",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        750,
        300
      ],
      "parameters": {
        "url": "http://crewai-api:8001/health",
        "method": "GET",
        "options": {}
      },
      "id": "d46c6da6-c8b6-537b-9f76-e44c603e47fc"
    },
    {
      "name": "Is_Healthy",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1000,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": ""
          },
          "conditions": [
            {
              "leftValue": "={{$json[\"status\"]}}",
              "rightValue": "healthy",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "c2cc31d3-2036-0cb4-f5f8-1aaebc381b55"
    },
    {
      "name": "Notify_Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [
        1250,
        300
      ],
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "[INFRASTRUCTURE_OPS] Workflow 1000 (by_priority) completed.\nResult: {{ $json.result }}",
        "additionalFields": {}
      },
      "credentials": {
        "telegramApi": {
          "id": "1",
          "name": "Telegram"
        }
      },
      "id": "888e0084-9265-d0c9-e78b-3efd01945159"
    }
  ],
  "connections": {
    "Schedule_by_priority": {
      "main": [
        [
          {
            "node": "Set_by_priority_Context",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set_by_priority_Context": {
      "main": [
        [
          {
            "node": "Health_Check",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Health_Check": {
      "main": [
        [
          {
            "node": "Is_Healthy",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is_Healthy": {
      "main": [
        [
          {
            "node": "Notify_Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner"
  },
  "tags": [
    {
      "name": "infrastructure"
    },
    {
      "name": "ops"
    }
  ]
}