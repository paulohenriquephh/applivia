{
  "name": "0900_monitoring_health_by_schedule_09",
  "nodes": [
    {
      "name": "Schedule_by_schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        250,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 0 */4 * * *"
            }
          ]
        }
      },
      "id": "8395e5b3-9bc7-b5f1-cbae-59f19efafb8c"
    },
    {
      "name": "Set_by_schedule_Context",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [
        500,
        300
      ],
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "0",
              "name": "category",
              "value": "monitoring_health",
              "type": "string"
            },
            {
              "id": "1",
              "name": "variation",
              "value": "by_schedule",
              "type": "string"
            },
            {
              "id": "2",
              "name": "workflow_id",
              "value": "900",
              "type": "string"
            }
          ]
        }
      },
      "id": "60660e23-bd48-7220-0c9c-ffc02c099651"
    },
    {
      "name": "Health_Check",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        750,
        300
      ],
      "parameters": {
        "url": "http://crewai-api:8001/health",
        "method": "GET",
        "options": {}
      },
      "id": "0eb3c1dd-bc39-44d5-a957-3c03dc7ee6e9"
    },
    {
      "name": "Is_Healthy",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1000,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": ""
          },
          "conditions": [
            {
              "leftValue": "={{$json[\"status\"]}}",
              "rightValue": "healthy",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "890f8891-7126-b1da-4048-e6a00a29e8f7"
    },
    {
      "name": "Notify_Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [
        1000,
        300
      ],
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "[MONITORING_HEALTH] Workflow 0900 (by_schedule) completed.\nResult: {{ $json.result }}",
        "additionalFields": {}
      },
      "credentials": {
        "telegramApi": {
          "id": "1",
          "name": "Telegram"
        }
      },
      "id": "798dc874-b481-3388-0de1-a4ea1c30551c"
    }
  ],
  "connections": {
    "Schedule_by_schedule": {
      "main": [
        [
          {
            "node": "Set_by_schedule_Context",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set_by_schedule_Context": {
      "main": [
        [
          {
            "node": "Health_Check",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Health_Check": {
      "main": [
        [
          {
            "node": "Is_Healthy",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is_Healthy": {
      "main": [
        [
          {
            "node": "Notify_Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner"
  },
  "tags": [
    {
      "name": "monitoring"
    },
    {
      "name": "health"
    }
  ]
}