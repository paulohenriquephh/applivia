{
  "name": "0965_infrastructure_ops_by_priority_02",
  "nodes": [
    {
      "name": "Schedule_by_priority",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        250,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 0 */8 * * *"
            }
          ]
        }
      },
      "id": "5e1986a8-65c2-f779-688b-aba1a3961255"
    },
    {
      "name": "Set_by_priority_Context",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [
        500,
        300
      ],
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "0",
              "name": "category",
              "value": "infrastructure_ops",
              "type": "string"
            },
            {
              "id": "1",
              "name": "variation",
              "value": "by_priority",
              "type": "string"
            },
            {
              "id": "2",
              "name": "workflow_id",
              "value": "965",
              "type": "string"
            }
          ]
        }
      },
      "id": "84b59c74-7f22-f33e-4dfb-364fe75ce646"
    },
    {
      "name": "Health_Check",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        750,
        300
      ],
      "parameters": {
        "url": "http://crewai-api:8001/health",
        "method": "GET",
        "options": {}
      },
      "id": "454932f3-7db7-ecdc-c9a5-060f7b0fffb6"
    },
    {
      "name": "Is_Healthy",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1000,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": ""
          },
          "conditions": [
            {
              "leftValue": "={{$json[\"status\"]}}",
              "rightValue": "healthy",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "4e2796b2-169d-f16b-81d0-8d0831a5d94b"
    },
    {
      "name": "Email_Report",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [
        1500,
        300
      ],
      "parameters": {
        "fromEmail": "={{ $env.EMAIL_FROM }}",
        "toEmail": "={{ $json.email }}",
        "subject": "[infrastructure_ops] Report - by_priority",
        "html": "<h2>infrastructure_ops Report</h2><p>Variation: by_priority</p><p>Result: {{$json.result}}</p>",
        "options": {}
      },
      "id": "56123092-771e-e749-5fe2-ad7829789571"
    }
  ],
  "connections": {
    "Schedule_by_priority": {
      "main": [
        [
          {
            "node": "Set_by_priority_Context",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set_by_priority_Context": {
      "main": [
        [
          {
