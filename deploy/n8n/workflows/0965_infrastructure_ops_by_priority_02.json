            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is_Healthy": {
      "main": [
        [
          {
            "node": "Email_Report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
