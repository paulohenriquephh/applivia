{
  "name": "0860_monitoring_health_by_schedule_01",
  "nodes": [
    {
      "name": "Schedule_by_schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        250,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 0 */4 * * *"
            }
          ]
        }
      },
      "id": "746e0946-eff5-afe3-64be-4f9fb9faf2e3"
    },
    {
      "name": "Set_by_schedule_Context",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [
        500,
        300
      ],
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "0",
              "name": "category",
              "value": "monitoring_health",
              "type": "string"
            },
            {
              "id": "1",
              "name": "variation",
              "value": "by_schedule",
              "type": "string"
            },
            {
              "id": "2",
              "name": "workflow_id",
              "value": "860",
              "type": "string"
            }
          ]
        }
      },
      "id": "37bc6d8b-5628-9a0b-66e5-9fd5c2e08535"
    },
    {
      "name": "Health_Check",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        750,
        300
      ],
      "parameters": {
        "url": "http://crewai-api:8001/health",
        "method": "GET",
        "options": {}
      },
      "id": "13f9bf46-b05d-2664-5e6c-d6f30e92dd4b"
    },
    {
      "name": "Is_Healthy",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1000,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": ""
          },
          "conditions": [
            {
              "leftValue": "={{$json[\"status\"]}}",
              "rightValue": "healthy",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "3ecb5ecc-1e98-3a6b-a104-0649723725c2"
    },
    {
      "name": "Notify_Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [
        1500,
        300
      ],
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "[MONITORING_HEALTH] Workflow 0860 (by_schedule) completed.\nResult: {{ $json.result }}",
        "additionalFields": {}
      },
      "credentials": {
        "telegramApi": {
          "id": "1",
          "name": "Telegram"
        }
      },
      "id": "f6eb4d67-5425-e1e8-f1c2-3f856e925e69"
    }
  ],
  "connections": {
    "Schedule_by_schedule": {
      "main": [
        [
          {
            "node": "Set_by_schedule_Context",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set_by_schedule_Context": {
      "main": [
        [
          {
            "node": "Health_Check",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Health_Check": {
      "main": [
        [
          {
            "node": "Is_Healthy",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is_Healthy": {
      "main": [
        [
          {
            "node": "Notify_Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner"
  },
  "tags": [
    {
      "name": "monitoring"
    },
    {
      "name": "health"
    }
  ]
}