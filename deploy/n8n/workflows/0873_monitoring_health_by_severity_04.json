              "leftValue": "={{$json[\"status\"]}}",
              "rightValue": "healthy",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "84bc0940-dd57-af01-652e-328e638fbdb4"
