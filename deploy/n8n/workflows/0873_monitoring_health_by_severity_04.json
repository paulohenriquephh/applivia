        1000,
        300
      ],
      "parameters": {
        "fromEmail": "={{ $env.EMAIL_FROM }}",
        "toEmail": "={{ $json.email }}",
        "subject": "[monitoring_health] Report - by_severity",
        "html": "<h2>monitoring_health Report</h2><p>Variation: by_severity</p><p>Result: {{$json.result}}</p>",
