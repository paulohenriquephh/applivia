{
  "name": "0989_infrastructure_ops_by_schedule_07",
  "nodes": [
    {
      "name": "Cron_by_schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        250,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 */5 * * * *"
            }
          ]
        }
      },
      "id": "620f7a05-9b57-ca3d-e9ac-74f07c291538"
    },
    {
      "name": "Set_by_schedule_Context",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [
        500,
        300
      ],
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "0",
              "name": "category",
              "value": "infrastructure_ops",
              "type": "string"
            },
            {
              "id": "1",
              "name": "variation",
              "value": "by_schedule",
              "type": "string"
            },
            {
              "id": "2",
              "name": "workflow_id",
              "value": "989",
              "type": "string"
            }
          ]
        }
      },
      "id": "a40bd0eb-317e-e08c-2c49-dc6771e6f849"
    },
    {
      "name": "Health_Check",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        750,
        300
      ],
      "parameters": {
        "url": "http://crewai-api:8001/health",
        "method": "GET",
        "options": {}
      },
      "id": "e451313c-3d4d-ac5f-4aec-bf43687c3b13"
    },
    {
      "name": "Is_Healthy",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1000,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": ""
          },
          "conditions": [
            {
              "leftValue": "={{$json[\"status\"]}}",
              "rightValue": "healthy",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "efb67359-ceb3-0c26-36c6-3394b9dc3186"
    },
    {
      "name": "Email_Report",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [
        1500,
        300
      ],
      "parameters": {
        "fromEmail": "={{ $env.EMAIL_FROM }}",
        "toEmail": "={{ $json.email }}",
        "subject": "[infrastructure_ops] Report - by_schedule",
        "html": "<h2>infrastructure_ops Report</h2><p>Variation: by_schedule</p><p>Result: {{$json.result}}</p>",
        "options": {}
      },
      "id": "01641315-f359-5d6a-06f1-58ed5ae7c5cc"
    }
  ],
  "connections": {
    "Cron_by_schedule": {
      "main": [
        [
          {
            "node": "Set_by_schedule_Context",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set_by_schedule_Context": {
