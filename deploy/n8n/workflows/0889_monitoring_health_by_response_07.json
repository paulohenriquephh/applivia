{
  "name": "0889_monitoring_health_by_response_07",
  "nodes": [
    {
      "name": "Cron_by_response",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        250,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 0 */4 * * *"
            }
          ]
        }
      },
      "id": "5fe4163c-67a6-cd4f-218b-be070eb8d541"
    },
    {
      "name": "Set_by_response_Context",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [
        500,
        300
      ],
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "0",
              "name": "category",
              "value": "monitoring_health",
              "type": "string"
            },
            {
              "id": "1",
              "name": "variation",
              "value": "by_response",
              "type": "string"
            },
            {
              "id": "2",
              "name": "workflow_id",
              "value": "889",
              "type": "string"
            }
          ]
        }
      },
      "id": "19c79a59-7771-de19-b0a4-b3fb537d27ab"
    },
    {
      "name": "Health_Check",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        750,
        300
      ],
      "parameters": {
        "url": "http://crewai-api:8001/health",
        "method": "GET",
        "options": {}
      },
      "id": "eb690f26-d25c-f46c-60d1-d2e565aa6a77"
    },
    {
      "name": "Is_Healthy",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1000,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": ""
          },
          "conditions": [
            {
              "leftValue": "={{$json[\"status\"]}}",
              "rightValue": "healthy",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "8d7f702a-9c10-d514-47a4-1121c1072062"
    },
    {
      "name": "Email_Report",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [
        1250,
        300
      ],
      "parameters": {
        "fromEmail": "={{ $env.EMAIL_FROM }}",
        "toEmail": "={{ $json.email }}",
        "subject": "[monitoring_health] Report - by_response",
        "html": "<h2>monitoring_health Report</h2><p>Variation: by_response</p><p>Result: {{$json.result}}</p>",
        "options": {}
      },
      "id": "b0ecb1fb-b369-e916-1664-31ff18206ca0"
    }
  ],
  "connections": {
    "Cron_by_response": {
      "main": [
        [
          {
            "node": "Set_by_response_Context",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set_by_response_Context": {
      "main": [
        [
          {
            "node": "Health_Check",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Health_Check": {
      "main": [
        [
          {
            "node": "Is_Healthy",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is_Healthy": {
      "main": [
        [
          {
            "node": "Email_Report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner"
