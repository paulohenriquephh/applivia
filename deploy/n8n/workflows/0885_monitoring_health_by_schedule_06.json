{
  "name": "0885_monitoring_health_by_schedule_06",
  "nodes": [
    {
      "name": "Schedule_by_schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        250,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 0 */8 * * *"
            }
          ]
        }
      },
      "id": "39f26f2a-768e-8d51-a2ed-721fa31852c2"
    },
    {
      "name": "Set_by_schedule_Context",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [
        500,
        300
      ],
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "0",
              "name": "category",
              "value": "monitoring_health",
              "type": "string"
            },
            {
              "id": "1",
              "name": "variation",
              "value": "by_schedule",
              "type": "string"
            },
            {
              "id": "2",
              "name": "workflow_id",
              "value": "885",
              "type": "string"
            }
          ]
        }
      },
      "id": "e7c4568e-f6ad-95a3-c6d3-bb23f9df50e8"
    },
    {
      "name": "Health_Check",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        750,
        300
      ],
      "parameters": {
        "url": "http://crewai-api:8001/health",
        "method": "GET",
        "options": {}
      },
      "id": "8285f293-75e6-9594-c173-b44869b1de6f"
    },
    {
      "name": "Is_Healthy",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1000,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": ""
          },
          "conditions": [
            {
              "leftValue": "={{$json[\"status\"]}}",
              "rightValue": "healthy",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "e28cdf84-8c55-9369-fbc8-61b4d78be8f6"
    },
    {
      "name": "Email_Report",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [
        1000,
        300
      ],
      "parameters": {
        "fromEmail": "={{ $env.EMAIL_FROM }}",
        "toEmail": "={{ $json.email }}",
        "subject": "[monitoring_health] Report - by_schedule",
        "html": "<h2>monitoring_health Report</h2><p>Variation: by_schedule</p><p>Result: {{$json.result}}</p>",
        "options": {}
      },
      "id": "2505bac9-e34f-a1fc-4a10-92fa7dc4c3e5"
    }
  ],
  "connections": {
    "Schedule_by_schedule": {
      "main": [
        [
          {
            "node": "Set_by_schedule_Context",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set_by_schedule_Context": {
      "main": [
        [
          {
