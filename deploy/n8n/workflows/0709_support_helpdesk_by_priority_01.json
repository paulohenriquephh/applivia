          "conditions": [
            {
              "leftValue": "={{$json[\"priority\"]}}",
              "rightValue": "high",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "702c7939-2bbc-1210-2c1e-caacdcd81805"
    },
